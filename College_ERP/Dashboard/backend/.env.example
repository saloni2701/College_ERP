# Copy to ".env" (never commit the real .env).
DB_HOST=localhost
DB_USER=root
DB_PASS=999333
DB_NAME=srm_attendance

# 5000 is used by the face-attendance app and browsers block 6000.
PORT=8000

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Secret the face-recognition system sends as the "x-api-key" header when it
# calls POST /api/attendance/mark. Generate it the same way.
ATTENDANCE_API_KEY=

# Optional: browser origins allowed to call the API (comma-separated).
# CORS_ORIGIN=http://localhost:3000
