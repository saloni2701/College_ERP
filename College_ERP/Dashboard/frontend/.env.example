# Copy this file to ".env" and restart "npm start" after changing it.
# Leave REACT_APP_API_URL empty (or delete the line) to run in demo mode.
#
# Ports used by this project: 3000 (frontend), 5000 (face attendance),
# 8000 (backend), 8501 (resume analyzer). Do not use 6000 - browsers block it.

# --- Everything on your own computer ---
REACT_APP_API_URL=http://localhost:8000/api

# --- GitHub Codespace ---
# Use these three lines INSTEAD of the line above (replace <name> with the value of
# $CODESPACE_NAME; run `echo $CODESPACE_NAME` in the Codespace terminal).
# "/api" is forwarded to the backend by the React dev server (src/setupProxy.js).
# REACT_APP_API_URL=/api
# REACT_APP_ATTENDANCE_URL=https://<name>-5000.app.github.dev/
# REACT_APP_RESUME_URL=https://<name>-8501.app.github.dev/
# WDS_SOCKET_PORT=443
