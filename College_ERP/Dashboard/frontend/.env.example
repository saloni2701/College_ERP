# Copy this file to ".env" and restart "npm start" after changing it.
# Leave REACT_APP_API_URL empty (or delete the line) to run in demo mode.
#
# Ports already used by this project: 3000 (frontend), 5000 (face attendance),
# 8501 (resume analyzer). Do not use 6000 - browsers block it.
REACT_APP_API_URL=http://localhost:8000/api
